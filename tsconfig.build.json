{
  "compilerOptions": {
    "module": "preserve",
    "target": "es6",
    "lib": ["es2017", "dom"],
    "rootDir": "./src",
    "outDir": "./dist",
    "mapRoot": "./dist",
    "moduleResolution": "bundler",
    "sourceRoot": "./src",
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "removeComments": false,
    "inlineSources": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "importHelpers": false,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "strict": true,
    "isolatedDeclarations": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "test"]
}
